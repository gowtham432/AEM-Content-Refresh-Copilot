GEMINI_API_KEY=your-key-here 
# Optional
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Bold Rewrite variant (Omni models use the Interactions API; falls back to GEMINI_MODEL if unavailable)
GEMINI_MODEL_BOLD=gemini-omni-1.1-flash
FRONTEND_URL=https://your-frontend.vercel.app

# Demo video linked from the demo-mode panel
DEMO_VIDEO_URL=https://youtu.be/mErtyRKxPn0

# The app always talks to AEM_HOST. Point it at a real AEM author, or at the bundled mock server:
#   uvicorn mock_aem_server:app --port 4502     (then set AEM_MODE=mock)
# AEM_MODE=mock only makes the UI show the "Demo mode" panel; live = a real AEM.
AEM_MODE=live
AEM_HOST=http://localhost:4502
AEM_USER=admin
AEM_PASSWORD=admin
